# این فایل را کپی کنید به .env و مقادیر را پر کنید.
# می‌توانید همان مقادیری که برای اتصال MCP دیتابیس (mssql-GNG) روی این
# سیستم تنظیم کرده‌اید را اینجا هم کپی کنید (DB_SERVER/DB_USER/DB_PASSWORD).

DB_SERVER=10.0.0.1
DB_PORT=1433
DB_DATABASE=GNG_AI_Dev
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# پورت اجرای این API (فرانت‌اند gng-mfr-app باید همین مقدار را صدا بزند)
API_PORT=4311

# فقط آدرس‌هایی که فرانت‌اند gng-mfr-app از آن‌ها باز می‌شود اجازه‌ی صدا
# زدن این API را دارند — با کاما جدا کنید. localhost برای اجرای روی همین
# سرور، و نام/IP سرور برای اجرا از سایر سیستم‌های شبکه (به README.md در
# پوشه‌ی gng-mfr-app نگاه کنید). اگر سیستم دیگری با خطای CORS مواجه شد،
# آدرسی که در مرورگرش باز کرده را همین‌جا اضافه کنید و API را دوباره اجرا
# کنید.
CORS_ORIGIN=http://localhost:4400,http://127.0.0.1:4400,http://GIG001N10355:4400
